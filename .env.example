# Local-only template. Copy to .env and replace placeholder values. Never
# commit .env or copy local placeholder secrets into production.
DATABASE_URL=postgresql://user:password@host:5432/postgres
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_ACCESS_CODE=123456
PUBLIC_APP_URL=http://localhost:8000

# Start safely. ACTIVE_DRAW_ID is required before relational mode is enabled.
RELATIONAL_STORE_ENABLED=false
ACTIVE_DRAW_ID=
REQUIRE_DATABASE_IN_PRODUCTION=true
MAINTENANCE_MODE=false
OPERATIONAL_STALE_JOB_SECONDS=1800
OPERATIONAL_READINESS_MAX_QUERY_MS=2000
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT_SECONDS=3
DATABASE_POOL_STARTUP_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000

# Marketplace defaults. Enable only after relational smoke tests pass.
TRADING_ENABLED=false
TRADING_MIN_PRICE_CENTS=100
TRADING_MAX_PRICE_CENTS=10000000
TRADING_REQUEST_TTL_SECONDS=86400
TRADING_POLL_SECONDS=15
TRADING_POLL_JITTER_PERCENT=20
TRADING_POLL_MAX_BACKOFF_SECONDS=120
TRADING_MARKET_CACHE_SECONDS=1.5
TRADING_HISTORY_LIMIT=50

# Gmail SMTP ticket emails (requires a host that permits outbound port 587)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=your.sender.account@gmail.com
SMTP_PASSWORD=replace-with-the-16-character-google-app-password
EMAIL_SENDER_ADDRESS=your.sender.account@gmail.com
EMAIL_SENDER_NAME=United Way Reverse Draw
