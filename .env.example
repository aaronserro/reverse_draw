# Local-only template. Copy to .env and replace placeholder values.
DATABASE_URL=
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_ACCESS_CODE=123456

# Free Render production email (HTTPS; SMTP ports are blocked on free Render)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=replace-with-the-brevo-api-key
EMAIL_SENDER_ADDRESS=your.sender.account@gmail.com
EMAIL_SENDER_NAME=United Way Reverse Draw
PUBLIC_APP_URL=http://localhost:8000

# Local or paid-host Gmail SMTP alternative:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=your.sender.account@gmail.com
# SMTP_PASSWORD=replace-with-the-16-character-google-app-password
